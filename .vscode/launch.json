{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "🐍 Debug Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "python": "${workspaceFolder}/.venv/bin/python",
            "windows": {
                "python": "${workspaceFolder}\\.venv\\Scripts\\python.exe"
            },
            "justMyCode": true
        },
        {
            "name": "🚀 Debug Engineering MCP Server",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/.scripts/run.py",
            "console": "integratedTerminal",
            "preLaunchTask": "📦 Sync Dependencies",
            "python": "${workspaceFolder}/.venv/bin/python",
            "windows": {
                "python": "${workspaceFolder}\\.venv\\Scripts\\python.exe"
            },
            "justMyCode": true
        }
    ]
}